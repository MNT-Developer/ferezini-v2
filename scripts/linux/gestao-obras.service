[Unit]
Description=Ferezini - Gestão Financeira de Obras
After=network.target mysql.service

[Service]
Type=simple
User=ferezini
Group=ferezini
WorkingDirectory=/opt/ferezini
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/opt/ferezini/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 90
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
