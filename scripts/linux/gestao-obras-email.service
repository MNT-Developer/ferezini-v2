[Unit]
Description=Ferezini - Processamento de e-mails
After=network.target mysql.service

[Service]
Type=oneshot
User=ferezini
Group=ferezini
WorkingDirectory=/opt/ferezini
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/opt/ferezini/.venv/bin/python manage.py processar_emails_pendentes
TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true
