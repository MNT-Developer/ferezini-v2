# Configuracao unica para HostMidia/cPanel; nunca publique o .env real.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=obras.seudominio.com
CSRF_TRUSTED_ORIGINS=https://obras.seudominio.com
# Deixe false se Passenger identifica HTTPS nativamente. Confirme com o provedor
# antes de confiar em X-Forwarded-Proto de um proxy que sobrescreva esse cabecalho.
TRUST_PROXY_HTTPS=false
# cPanel geralmente acrescenta o prefixo da conta ao nome do banco/usuario.
DB_NAME=conta_frz
DB_USER=conta_frz
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=0
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Ferezini <financeiro@seudominio.com>
